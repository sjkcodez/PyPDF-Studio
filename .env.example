# ─────────────────────────────────────────────────────────
# PyPDF Studio — environment template
# Copy this to ".env" and fill in real values.
# NEVER commit the real ".env" file to git.
# ─────────────────────────────────────────────────────────

# Admin login credentials
PYPDF_ADMIN_USER=admin
PYPDF_ADMIN_PASS=change-me-to-a-strong-password
PYPDF_SECRET_KEY=generate-with-python-secrets-token-hex-32
PYPDF_RATE_LIMIT=30

# Set to 1 when running behind HTTPS (Hostinger/VPS with nginx+SSL)
# Leave at 0 on Render if you're not sure — Render handles SSL itself.
PYPDF_FORCE_HTTPS=0
